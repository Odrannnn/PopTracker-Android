# exclude build output
build/
dist/

# exclude AppImage build files
/appimage-build
/AppDir
*.AppImage
*.AppImage.zsync

# exclude cache files
*~
.DS_Store
thumbs.db
gmon.out
.cacert.sha256.etag

# exclude unused and scratch pad files
.trash
/img
/util

# exclude project files
nbproject

# exclude packs (they are separate projects)
packs
!schema/packs
screenshots
packlist
pop-pack-create-versions

# exclude tool chain dependent files
win32-lib
win32-lib-src

# fuzzer files
/corpus/
/fuzz-*.log
/oom-*
/crash-*
macosx/libs/

# Android/Gradle build output and machine-local SDK settings
android/.gradle/
/.gradle-user/
android/.idea/
android/**/.cxx/
android/**/build/
android/local.properties
*.apk
*.aab

# exclude development environment specific files
.vs/
CppProperties.json
